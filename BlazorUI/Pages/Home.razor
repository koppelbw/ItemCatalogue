@page "/"
@using BlazorUI.Components

<PageTitle>Home!</PageTitle>

<PageHeader
    Title="Home"
    Subtitle="This is the new Blazor WASM Standalone UI"
/>

<button @onclick="() => showErrorAlert = true">Show Error Alert</button>

@if (showErrorAlert)
{
    <ErrorAlert 
        Message="error message here"
        OnDismiss="() => showErrorAlert = false">
        <p>This is the ChildContent injected into the erroralert component</p>
    </ErrorAlert>
}

@if(isLoading)
{
    <LoadingSpinner />
}
else
{
    <p>Loaded!</p>
}

@code{
    bool showErrorAlert = false;
    bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();    // call base method first

        await Task.Delay(2000);
        isLoading = false;
    }
}